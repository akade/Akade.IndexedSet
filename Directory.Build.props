<Project>
  <PropertyGroup>
    <!-- Single source of truth for multi-targeting. Projects opt in with <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks> -->
    <SupportedTargetFrameworks>net8.0;net9.0;net10.0</SupportedTargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- Only the main library is packed; it overrides this -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
